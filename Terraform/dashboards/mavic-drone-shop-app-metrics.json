{
  "title": "Mavic Drone Shop - Application Metrics",
  "uid": "mavic-drone-shop-app",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "tags": ["mavic-drone-shop"],
  "panels": [
    {
      "id": 1,
      "title": "Cart - Items Added / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(items_added[5m])", "refId": "A", "datasource": null }
      ]
    },
    {
      "id": 2,
      "title": "Catalogue - Product Views / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "rate(product_views[5m])", "refId": "A", "datasource": null }
      ]
    },
    {
      "id": 3,
      "title": "User - Logins / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "rate(user_logins[5m])", "refId": "A", "datasource": null }
      ]
    },
    {
      "id": 4,
      "title": "Payment - Items Sold / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "rate(sold_count[5m])", "refId": "A", "datasource": null }
      ]
    },
    {
      "id": 5,
      "title": "Ratings - Submissions / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "rate(ratings_submitted[5m])", "refId": "A", "datasource": null }
      ]
    },
    {
      "id": 6,
      "title": "Dispatch - Orders Processed / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "rate(orders_processed[5m])", "refId": "A", "datasource": null }
      ]
    },
    {
      "id": 7,
      "title": "Web - Nginx Requests / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "rate(nginx_http_requests_total[5m])", "refId": "A", "datasource": null }
      ]
    },
    {
      "id": 8,
      "title": "Shipping - HTTP Requests / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "rate(http_server_requests_seconds_count[5m])", "refId": "A", "datasource": null }
      ]
    }
  ]
}
